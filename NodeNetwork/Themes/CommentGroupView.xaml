<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:NodeNetwork.Views"
                    xmlns:viewModels="clr-namespace:NodeNetwork.ViewModels">
    <Style TargetType="{x:Type views:CommentGroupView}">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:CommentGroupView">
                    <Grid>
                        <!-- Outer border with accent color -->
                        <Border x:Name="OuterBorder"
                                BorderBrush="{TemplateBinding AccentBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Background="{TemplateBinding FillBrush}">
                            <Grid>
                                <!-- Header bar -->
                                <Border x:Name="HeaderBar"
                                        Background="{TemplateBinding AccentBrush}"
                                        CornerRadius="2,2,0,0"
                                        VerticalAlignment="Top"
                                        Height="28">
                                    <DockPanel>
                                        <TextBlock x:Name="NameLabel"
                                                   DockPanel.Dock="Left"
                                                   Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,8,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Border>

                                <!-- Resize handle: bottom-right corner -->
                                <Thumb x:Name="ResizeDiagonalThumb"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Width="12" Height="12"
                                       Cursor="SizeNWSE">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Path Data="M 0,12 L 12,0 L 12,12 Z"
                                                  Fill="{Binding RelativeSource={RelativeSource AncestorType={x:Type views:CommentGroupView}}, Path=AccentBrush}"
                                                  Opacity="0.8"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                                <!-- Resize handle: right edge -->
                                <Thumb x:Name="ResizeHorizontalThumb"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Width="6"
                                       Cursor="SizeWE"
                                       Margin="0,28,0,12">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Canvas Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>

                                <!-- Resize handle: bottom edge -->
                                <Thumb x:Name="ResizeVerticalThumb"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       Height="6"
                                       Cursor="SizeNS"
                                       Margin="0,0,12,0">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Canvas Background="Transparent"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Border>

                        <!-- Selection highlight overlay -->
                        <Border x:Name="SelectionBorder"
                                BorderBrush="White"
                                BorderThickness="0"
                                CornerRadius="4"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="OuterBorder" Property="BorderThickness" Value="2"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
